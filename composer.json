{
    "name": "jorisnoo/craft-twig-helpers",
    "description": "Shared Twig helpers for Craft CMS with config-based extensibility.",
    "type": "craft-module",
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "twig",
        "helpers"
    ],
    "authors": [
        {
            "name": "Joris Noordermeer",
            "email": "contact@noordermeer.ch",
            "homepage": "https://github.com/jorisnoo"
        }
    ],
    "autoload": {
        "psr-4": {
            "Noo\\CraftTwigHelpers\\": "src/"
        }
    },
    "require": {
        "php": "^8.4",
        "craftcms/cms": "^4.3.5 || ^5.0.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18.1",
        "pestphp/pest": "^5.3.5"
    },
    "scripts": {
        "lint": "pint",
        "check": [
            "@composer validate --strict",
            "@composer audit",
            "pint --test",
            "pest"
        ]
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        }
    }
}
